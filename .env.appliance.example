# Appliance environment file for the pull-only release Compose bundle.
# Copy this file to .env and replace every placeholder value.
# Generate secrets with: openssl rand -hex 32  (and  openssl rand -base64 32)

# Release tag. Pin a specific tag for reproducible upgrades. Default is latest.
IPTV_VERSION=latest

# Host address and port for the public gateway. Keep 127.0.0.1 for local use.
# Set a LAN address only behind a TLS reverse proxy.
IPTV_GATEWAY_BIND=127.0.0.1
IPTV_GATEWAY_PORT=8080

# Public URL that clients use to reach output endpoints.
IPTV_PUBLIC_BASE_URL=http://localhost:8080

# Strong database password. Do not change it after the first start.
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# 64 random hex characters. Protects /out/{token}/... endpoints.
IPTV_OUTPUT_TOKEN=replace-with-64-random-hex-characters

# 64 random hex characters. Admin bearer token, disabled after first sign-in.
IPTV_ADMIN_BOOTSTRAP_TOKEN=replace-with-64-random-hex-characters

# Admin password for the operator account. 12 or more characters.
IPTV_ADMIN_PASSWORD=replace-with-a-strong-password-of-12-or-more-characters

# Optional Argon2id PHC hash. When set, the plaintext password is ignored.
IPTV_ADMIN_PASSWORD_HASH=

# 32-byte base64 key. Encrypts source credentials at rest.
# core and worker must use the same key.
IPTV_MASTER_KEY=replace-with-32-byte-base64-key

# HDHomeRun tuner count reported by the output profile.
# Default is 1. This example overrides the default to 3.
IPTV_TUNER_COUNT=3

# Health probes are disabled by default. Set to true to enable periodic
# stream health checks for streams mapped to enabled channels.
IPTV_HEALTH_PROBES_ENABLED=false

# Number of worker replicas.
IPTV_WORKER_COUNT=4

# Log level. Use info,iptv_gateway=debug for detailed logs.
RUST_LOG=info
