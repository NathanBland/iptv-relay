POSTGRES_PASSWORD=replace-with-a-strong-database-password
IPTV_GATEWAY_BIND=127.0.0.1
IPTV_GATEWAY_PORT=8080
IPTV_BIND=0.0.0.0:8081
IPTV_PUBLIC_BASE_URL=http://localhost:8080
IPTV_OUTPUT_TOKEN=replace-with-64-random-hex-characters
IPTV_ADMIN_BOOTSTRAP_TOKEN=replace-with-64-random-hex-characters
IPTV_ADMIN_PASSWORD=replace-with-a-strong-password-of-12-or-more-characters
# Prefer a PHC-formatted Argon2id hash in production. When set, the plaintext
# password variable is ignored by the core service.
IPTV_ADMIN_PASSWORD_HASH=
IPTV_MASTER_KEY=replace-with-32-byte-base64-key
IPTV_TUNER_COUNT=3
RUST_LOG=info,iptv_gateway=debug

# Optional live-provider acceptance inputs. Never commit real values.
IPTV_TEST_M3U_URL=
IPTV_TEST_XMLTV_URL=
IPTV_TEST_PROVIDER_MAX_CONNECTIONS=3

# Gateway live acceptance (live-acceptance-gateway compose service).
# Set LIVE_ACCEPTANCE_SOAK=1 to run an optional 30-minute soak scenario.
LIVE_ACCEPTANCE_SECONDS=120
LIVE_ACCEPTANCE_CHANNELS=3
LIVE_ACCEPTANCE_PROVIDER_CAP=3
LIVE_ACCEPTANCE_SOAK=0
LIVE_ACCEPTANCE_SOAK_SECONDS=1800
