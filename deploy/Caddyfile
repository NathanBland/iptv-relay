{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	@sse path /api/v1/session-events /api/v1/catalog-events
	handle @sse {
		reverse_proxy core:8081 {
			flush_interval -1
		}
	}

	@core path /api/* /auth/* /health/* /metrics /out/*
	handle @core {
		reverse_proxy core:8081
	}

	handle {
		header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self' data:"
		reverse_proxy web:3000
	}
}
